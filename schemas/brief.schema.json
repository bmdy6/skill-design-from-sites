{
  "type": "object",
  "required": [
    "schemaVersion",
    "owner",
    "goal",
    "pageTypes",
    "references",
    "likeWords",
    "avoidWords",
    "constraints",
    "needInspire"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "enum": [
        "personal",
        "company"
      ]
    },
    "owner": {
      "enum": [
        "self",
        "boss"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "pageTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "note"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "likeWords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avoidWords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "theme",
        "brandColor"
      ],
      "properties": {
        "theme": {
          "enum": [
            "any",
            "light",
            "dark"
          ]
        },
        "brandColor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "needInspire": {
      "type": "boolean"
    },
    "company": {
      "type": "object",
      "required": [
        "audience",
        "existingPages",
        "mustKeep",
        "allowedChanges",
        "externalInspiration",
        "approvers"
      ],
      "properties": {
        "existingPages": {
          "type": "string",
          "minLength": 1
        },
        "externalInspiration": {
          "type": "boolean"
        },
        "mustKeep": {
          "type": "array"
        },
        "allowedChanges": {
          "type": "array"
        },
        "approvers": {
          "type": "array"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "needInspire": {
            "const": false
          },
          "mode": {
            "const": "personal"
          }
        }
      },
      "then": {
        "properties": {
          "references": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "company"
          }
        }
      },
      "then": {
        "required": [
          "company"
        ]
      }
    }
  ]
}