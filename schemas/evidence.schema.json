{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schemaVersion",
    "siteId",
    "url",
    "hasCssVars",
    "clusters",
    "scales",
    "autoNames",
    "samples",
    "outliers",
    "componentCandidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "siteId": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "hasCssVars": {
      "type": "boolean"
    },
    "clusters": {
      "type": "object",
      "required": [
        "color",
        "fontFamily",
        "fontSize",
        "spacing",
        "radius",
        "shadow"
      ]
    },
    "scales": {
      "type": "object"
    },
    "autoNames": {
      "type": "object"
    },
    "samples": {
      "type": "object"
    },
    "outliers": {
      "type": "array"
    },
    "componentCandidates": {
      "type": "array"
    }
  }
}
